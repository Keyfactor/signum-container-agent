# --------------------------------------------------------------------------
# Stage 1: build OpenSC from source (no opensc package for the Signum base image; build tools are installed with apk in a throwaway stage)
# --------------------------------------------------------------------------
FROM repo.keyfactor.com/images/signum-agent:latest AS builder

# Pinned to an upstream master commit: OpenSC 0.27.1 (latest release) does not build against
# OpenSSL 4, which the Signum base image ships. Switch to a release tarball once 0.28 or later is out.
ARG OPENSC_COMMIT="ccfa7600f7c7ae249118d5f301e679e476a004a5"
ARG OPENSC_DOWNLOAD_CHECKSUM="sha256:4886aa2a8b82a40a049e419e5584a4fadf65c66b7afeeb1bf29dbab70d6adc14"

USER root
WORKDIR /build/

RUN apk update \
    && apk add build-base curl autoconf automake libtool pkgconf pkgconf-dev openssl-dev pcsc-lite-dev zlib-dev

# Download the source archive and verify it against the pinned checksum
RUN curl -fsSL -o /build/opensc.tar.gz \
        "https://github.com/OpenSC/OpenSC/archive/${OPENSC_COMMIT}.tar.gz" \
    && echo "${OPENSC_DOWNLOAD_CHECKSUM#sha256:}  /build/opensc.tar.gz" | sha256sum -c -

# Source archives (unlike release tarballs) need bootstrap to generate configure
RUN tar xf opensc.tar.gz \
    && cd "OpenSC-${OPENSC_COMMIT}" \
    && ./bootstrap \
    && ./configure -q --prefix=/usr --sysconfdir=/etc \
        --disable-doc --disable-man --disable-notify --disable-readline --disable-tests \
    && make -j"$(nproc)" \
    && make install DESTDIR=/stage

# Keep only what the final image needs (cp -a keeps the soname symlinks)
RUN mkdir -p /out/opt/opensc/bin /out/usr/lib/pkcs11 \
    && cp -a /stage/usr/bin/pkcs11-tool /out/opt/opensc/bin/ \
    && cp -a /stage/usr/lib/pkcs11/opensc-pkcs11.so /out/usr/lib/pkcs11/ \
    && cp -a /stage/usr/lib/opensc-pkcs11.so /stage/usr/lib/libopensc.so* /stage/usr/lib/libsmm-local.so* /out/usr/lib/

# --------------------------------------------------------------------------
# Stage 2: layer OpenSC onto the Signum agent image
# --------------------------------------------------------------------------
FROM repo.keyfactor.com/images/signum-agent:latest

# As of signum-agent 4.80.1 OpenSC is no longer bundled in the base image; this layers
# pkcs11-tool back on, for inspecting and debugging the Signum PKCS#11 token.
COPY --from=builder /out/ /

ENV PATH="$PATH:/opt/opensc/bin"
